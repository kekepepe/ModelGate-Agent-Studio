{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
