# ModelGate Agent Studio Backend Configuration

# Database
DATABASE_URL=sqlite:///./modelgate.db

# Model Provider (mock | openai)
MODEL_PROVIDER=mock

# OpenAI-compatible Provider (used when MODEL_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_TIMEOUT=60

# Server
APP_NAME=ModelGate Agent Studio
DEBUG=true
API_V1_PREFIX=/api/v1
