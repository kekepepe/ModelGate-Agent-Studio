# ModelGate Agent Studio Backend Configuration

# Database
DATABASE_URL=sqlite:///./modelgate.db

# Runtime mode: live | sandbox | dry_run | mock. Mock is explicit test/demo only.
MODEL_GATE_EXECUTION_MODE=live
# Backward-compatible alias; MODEL_GATE_EXECUTION_MODE takes precedence.
EXECUTION_MODE=live

# The root that all agent file and terminal tools are confined to.
WORKSPACE_ROOT=.
TOOL_TIMEOUT_SECONDS=120
MAX_TOOL_OUTPUT_CHARS=12000
MAX_FILE_WRITE_BYTES=1048576
TASK_LEASE_SECONDS=300
MAX_REQUEST_BODY_BYTES=5242880
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Optional second isolation boundary for sandbox-mode terminal/test tools.
# local keeps the command policy but runs on the host; docker adds an isolated,
# network-disabled container that mounts only the selected workspace.
SANDBOX_BACKEND=local
SANDBOX_IMAGE=python:3.12.8-slim-bookworm

# OpenAI-compatible Provider. Keep real secrets outside this file and database.
PROVIDER_API_BASE=https://api.openai.com/v1
PROVIDER_API_KEY=
PROVIDER_TIMEOUT_SECONDS=60
PLANNER_MODEL_NAME=
WORKER_MODEL_NAME=
VERIFIER_MODEL_NAME=
EMBEDDING_MODEL_NAME=
EMBEDDING_BACKEND=local_hash
# Backward-compatible aliases.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_TIMEOUT=60

# Server
APP_NAME=ModelGate Agent Studio
DEBUG=true
API_V1_PREFIX=/api/v1
